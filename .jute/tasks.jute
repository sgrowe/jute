
install:
    env RUSTC_BOOTSTRAP=1 "RUSTFLAGS=-Zunstable-options -Cpanic=immediate-abort" cargo install --path . -Z build-std=std,panic_abort -Z build-std-features=optimize_for_size -Z target-applies-to-host --config target-applies-to-host=false

validate:
    cargo fmt
    cargo clippy  --quiet --fix --all-targets --allow-dirty
    cargo test --quiet


test:
    cargo fmt --check
    cargo clippy --all-targets
    cargo test --quiet
